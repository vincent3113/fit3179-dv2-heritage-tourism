{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
  "description":"Butterfly chart comparing Historic-classified memberships with Natural or Indigenous memberships. Full state names occupy a central gutter. Both sides begin at a labelled zero baseline and use equal count units. Position offsets create the gutter only, never additional places. Cross-state places count in each relevant state.",
  "width":"container","height":570,"autosize":{"type":"fit","contains":"padding"},"padding":{"left":8,"right":20,"top":12,"bottom":8},
  "data":{"url":"https://raw.githubusercontent.com/vincent3113/fit3179-dv2-heritage-tourism/main/data/heritage-state-class.json"},
  "transform":[
    {"calculate":"datum.natural_places + datum.indigenous_places","as":"natural_or_indigenous_places"},
    {"fold":["historic_places","natural_or_indigenous_places"],"as":["classification_field","class_count"]},
    {"calculate":"datum.classification_field == 'historic_places' ? 'Historic' : 'Natural or Indigenous'","as":"comparison_group"},
    {"calculate":"datum.classification_field == 'historic_places' ? -datum.class_count : datum.class_count","as":"signed_count"},
    {"calculate":"datum.classification_field == 'historic_places' ? -8 : 8","as":"bar_baseline"},
    {"calculate":"datum.bar_baseline + datum.signed_count","as":"plot_count"},
    {"calculate":"format(datum.class_count,',d') + ' of ' + format(datum.listed_places,',d')","as":"count_of_total"},
    {"calculate":"format(100 * datum.class_count / datum.listed_places,'.1f') + '%'","as":"bar_share_label"},
    {"calculate":"datum.historic_places + ' Historic, ' + datum.natural_places + ' Natural, ' + datum.indigenous_places + ' Indigenous'","as":"state_breakdown"}
  ],
  "encoding":{
    "y":{"field":"state_name","type":"nominal","sort":["New South Wales","Victoria","Western Australia","Queensland","Tasmania","South Australia","Northern Territory","Australian Capital Territory"],"axis":null},
    "x":{"field":"plot_count","type":"quantitative","stack":null,"scale":{"domain":[-38,38],"zero":true,"nice":false},"axis":{"title":"Number of listed places","values":[-38,-28,-18,-8,8,18,28,38],"labelExpr":"abs(datum.value) - 8"}},
    "color":{"field":"comparison_group","type":"nominal","scale":{"domain":["Historic","Natural or Indigenous"],"range":["#4d3599","#a58b00"]},"legend":null},
    "tooltip":[{"field":"state_name","title":"State or territory"},{"field":"comparison_group","title":"Bar group"},{"field":"count_of_total","title":"Places in this group"},{"field":"bar_share_label","title":"Share of the state list"},{"field":"state_breakdown","title":"State classification counts"}]
  },
  "layer":[
    {"mark":{"type":"bar","size":36},"encoding":{"x2":{"field":"bar_baseline"},"opacity":{"condition":{"test":"indexof(['NSW','VIC'],datum.state_code) >= 0","value":1},"value":0.45}}},
    {"mark":{"type":"text","fontSize":16,"align":{"expr":"datum.classification_field == 'historic_places' ? 'right' : 'left'"},"dx":{"expr":"datum.classification_field == 'historic_places' ? -8 : 8"}},"encoding":{"text":{"field":"class_count"},"color":{"value":"#20303d"}}},
    {
      "name":"context_annotation",
      "transform":[
        {"filter":"datum.state_code == 'VIC' && datum.classification_field == 'historic_places'"},
        {"calculate":"['Goldfields and rebellion','sites count as Historic']","as":"comparison_note"},
        {"calculate":"datum.bar_baseline + datum.signed_count / 2","as":"annotation_x"}
      ],
      "mark":{"type":"text","fontSize":13,"lineHeight":16,"dy":-8},
      "encoding":{"x":{"field":"annotation_x","type":"quantitative"},"text":{"field":"comparison_note"},"color":{"value":"white"},"tooltip":null}
    },
    {"name":"zero_guides","transform":[{"aggregate":[{"op":"count","as":"states"}],"groupby":["bar_baseline"]}],"mark":{"type":"rule","strokeWidth":1.5},"encoding":{"x":{"field":"bar_baseline","type":"quantitative"},"y":{"value":0},"y2":{"value":{"expr":"height"}},"color":{"value":"#8b9ba7"},"tooltip":null}},
    {
      "name":"state_names",
      "transform":[
        {"filter":"datum.classification_field == 'historic_places'"},
        {"calculate":"datum.state_code == 'ACT' ? ['Australian Capital','Territory'] : [datum.state_name]","as":"state_lines"}
      ],
      "mark":{"type":"text","fontSize":16,"lineHeight":20},
      "encoding":{"x":{"datum":0},"text":{"field":"state_lines"},"color":{"value":"#20303d"},"tooltip":null}
    }
  ],
  "config":{"font":"Source Sans 3","view":{"stroke":null},"axis":{"labelFontSize":16,"titleFontSize":16,"titleFontWeight":"normal","labelColor":"#20303d","titleColor":"#20303d","gridColor":"#e7edf1","domain":false,"ticks":false}}
}
