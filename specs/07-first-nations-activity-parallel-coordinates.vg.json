{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel coordinates for two aggregate First Nations trip-group profiles across seven activity dimensions. Every vertical axis uses the same original 0–100% scale. Lines connect activities, not years, individual travellers or visitor flows. Activities overlap.",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 8, "right": 20, "top": 70, "bottom": 24},
  "data": {
    "url": "https://raw.githubusercontent.com/vincent3113/fit3179-dv2-heritage-tourism/main/data/first-nations-activities.json"
  },
  "transform": [
    {"calculate": "indexof(['site_community','art_craft_cultural_displays','traditional_activities','guided_tour','performance','food_experience','camping'],datum.activity_id)", "as": "activity_index"},
    {"calculate": "datum.activity_id == 'site_community' ? 'Site or|community visits' : datum.activity_id == 'art_craft_cultural_displays' ? 'Art, craft and|cultural displays' : datum.activity_id == 'traditional_activities' ? 'Traditional|activities' : datum.activity_id == 'guided_tour' ? 'Guided|tours' : datum.activity_id == 'performance' ? 'Performances' : datum.activity_id == 'food_experience' ? 'Food|experiences' : 'Camping'", "as": "dimension_title"},
    {"calculate": "split(datum.dimension_title,'|')", "as": "dimension_lines"},
    {"calculate": "datum.cohort == 'international' ? 'International' : 'Domestic day and overnight'", "as": "cohort_display"},
    {"calculate": "format(datum.share_of_fn_trips_2023_24_pct_reported,'.0f') + '%'", "as": "share_label"}
  ],
  "encoding": {
    "x": {"field": "activity_index", "type": "quantitative", "scale": {"domain": [-0.65, 6.65], "nice": false, "zero": false}, "axis": null},
    "y": {"field": "share_of_fn_trips_2023_24_pct_reported", "type": "quantitative", "scale": {"domain": [0, 100], "nice": false, "zero": true}, "axis": null},
    "tooltip": [
      {"field": "activity_label_source", "title": "Source activity wording"},
      {"field": "cohort_display", "title": "Trip group"},
      {"field": "share_label", "title": "Share of First Nations trips"},
      {"field": "trips_2023_24_reported", "title": "Reported activity trips", "format": ","}
    ]
  },
  "layer": [
    {
      "name": "dimension_axes",
      "transform": [{"filter": "datum.cohort == 'domestic_day_and_overnight'"}],
      "mark": {"type": "rule", "color": "#b6c3cc", "strokeWidth": 1},
      "encoding": {"y": {"datum": 0}, "y2": {"datum": 100}, "tooltip": null}
    },
    {
      "name": "dimension_ticks",
      "transform": [
        {"filter": "datum.cohort == 'domestic_day_and_overnight'"},
        {"calculate": "[0,20,40,60,80,100]", "as": "calibration"},
        {"flatten": ["calibration"], "as": ["tick_value"]}
      ],
      "mark": {"type": "tick", "orient": "horizontal", "size": 8, "thickness": 1, "color": "#b6c3cc", "opacity": 1},
      "encoding": {"y": {"field": "tick_value", "type": "quantitative"}, "tooltip": null}
    },
    {
      "name": "dimension_tick_labels",
      "transform": [
        {"filter": "datum.cohort == 'domestic_day_and_overnight' && datum.activity_index == 0"},
        {"calculate": "[0,20,40,60,80,100]", "as": "calibration"},
        {"flatten": ["calibration"], "as": ["tick_value"]},
        {"calculate": "datum.tick_value + '%'", "as": "tick_label"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 13, "color": "#526574"},
      "encoding": {"y": {"field": "tick_value", "type": "quantitative"}, "text": {"field": "tick_label"}, "tooltip": null}
    },
    {
      "name": "dimension_titles",
      "transform": [{"filter": "datum.cohort == 'domestic_day_and_overnight'"}],
      "mark": {"type": "text", "baseline": "bottom", "lineHeight": 20, "fontSize": 16, "color": "#20303d"},
      "encoding": {"y": {"value": -40}, "text": {"field": "dimension_lines"}, "tooltip": null}
    },
    {
      "name": "cohort_profiles",
      "mark": {"type": "line", "interpolate": "linear", "strokeWidth": 2.5},
      "encoding": {
        "detail": {"field": "cohort", "type": "nominal"},
        "order": {"field": "activity_index", "type": "quantitative", "sort": "ascending"},
        "color": {"field": "cohort", "type": "nominal", "scale": {"domain": ["domestic_day_and_overnight", "international"], "range": ["#4e5d6c", "#9a4787"]}, "legend": null},
        "strokeDash": {"field": "cohort", "type": "nominal", "scale": {"domain": ["domestic_day_and_overnight", "international"], "range": [[1,0], [6,4]]}, "legend": null}
      }
    },
    {
      "name": "percentage_labels",
      "mark": {"type": "text", "fontSize": 16, "stroke": "white", "strokeWidth": 3, "align": {"expr": "datum.cohort == 'domestic_day_and_overnight' ? 'right' : 'left'"}, "dx": {"expr": "datum.cohort == 'domestic_day_and_overnight' ? -12 : 12"}},
      "encoding": {
        "text": {"field": "share_label"},
        "color": {"field": "cohort", "type": "nominal", "scale": {"domain": ["domestic_day_and_overnight", "international"], "range": ["#4e5d6c", "#9a4787"]}, "legend": null}
      }
    },
    {
      "name": "gap_annotation",
      "transform": [
        {"joinaggregate": [{"op": "min", "field": "share_of_fn_trips_2023_24_pct_reported", "as": "lower_share"}], "groupby": ["activity_id"]},
        {"filter": "datum.activity_id == 'art_craft_cultural_displays' && datum.cohort == 'international'"},
        {"calculate": "format(datum.share_of_fn_trips_2023_24_pct_reported - datum.lower_share,'.0f') + ' percentage points higher|than domestic trips'", "as": "gap_note"},
        {"calculate": "split(datum.gap_note,'|')", "as": "gap_lines"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "dy": -40, "fontSize": 14, "lineHeight": 19, "fontWeight": 600, "color": "#20303d"},
      "encoding": {"text": {"field": "gap_lines"}, "tooltip": null}
    }
  ],
  "config": {"font": "Source Sans 3", "view": {"stroke": null}}
}
