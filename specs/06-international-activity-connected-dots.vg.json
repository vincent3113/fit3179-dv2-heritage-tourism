{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
  "description":"Three international activities with counts in both July-to-June periods. Questions expanded from 2022.",
  "width":"container","height":370,"autosize":{"type":"fit","contains":"padding"},"padding":{"left":8,"right":24,"top":30,"bottom":8},
  "data":{"url":"./data/first-nations-activities.json"},
  "transform":[
    {"filter":"datum.cohort == 'international' && isValid(datum.trips_2018_19_reported) && isValid(datum.trips_2023_24_reported)"},
    {"calculate":"datum.activity_id == 'art_craft_cultural_displays' ? 'Art, craft and|cultural displays' : datum.activity_id == 'site_community' ? 'Site or community|visits' : 'Performances'","as":"activity_display"},
    {"calculate":"datum.trips_2023_24_reported - datum.trips_2018_19_reported","as":"difference"},
    {"calculate":"(datum.trips_2023_24_reported + datum.trips_2018_19_reported) / 2","as":"midpoint"},
    {"calculate":"datum.difference > 0 ? format(datum.difference,'+,d') + ' reported trips' : format(-datum.difference,',d') + ' fewer reported trips'","as":"change_note"}
  ],
  "encoding":{
    "x":{"field":"trips_2018_19_reported","type":"quantitative","scale":{"domain":[0,900000],"zero":true},"axis":{"title":"Reported international activity trips","values":[0,200000,400000,600000,800000],"format":",.0f"}},
    "y":{"field":"activity_display","type":"nominal","sort":["Art, craft and|cultural displays","Site or community|visits","Performances"],"axis":{"title":null,"labelExpr":"split(datum.label,'|')","labelLineHeight":20,"labelLimit":180,"minExtent":138}},
    "tooltip":[{"field":"activity_label_source","title":"Source activity"},{"field":"trips_2018_19_reported","title":"July 2018 to June 2019","format":",.0f"},{"field":"trips_2023_24_reported","title":"July 2023 to June 2024","format":",.0f"},{"field":"difference","title":"Later minus earlier estimate","format":"+,d"}]
  },
  "layer":[
    {"mark":{"type":"rule","color":"#8b9ba7","strokeWidth":2},"encoding":{"x2":{"field":"trips_2023_24_reported"}}},
    {"mark":{"type":"point","filled":false,"size":90,"color":"#1d5f99","strokeWidth":2,"opacity":1}},
    {"mark":{"type":"point","filled":true,"size":90,"color":"#1d5f99","opacity":1},"encoding":{"x":{"field":"trips_2023_24_reported","type":"quantitative"}}},
    {"mark":{"type":"text","dy":-19,"fontSize":14,"color":"#20303d"},"encoding":{"text":{"field":"trips_2018_19_reported","format":",.0f"}}},
    {"mark":{"type":"text","dy":20,"fontSize":14,"color":"#20303d"},"encoding":{"x":{"field":"trips_2023_24_reported","type":"quantitative"},"text":{"field":"trips_2023_24_reported","format":",.0f"}}},
    {"mark":{"type":"text","dy":-46,"fontSize":14,"fontWeight":600,"color":"#20303d"},"encoding":{"x":{"field":"midpoint","type":"quantitative"},"text":{"field":"change_note"},"tooltip":null}}
  ],
  "config":{"font":"Source Sans 3","view":{"stroke":null},"axis":{"labelFontSize":14,"titleFontSize":14,"titleFontWeight":"normal","labelColor":"#20303d","titleColor":"#20303d","gridColor":"#e7edf1","domain":false,"ticks":false}}
}
