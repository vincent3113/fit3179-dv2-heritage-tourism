{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
  "description":"Share of each state's listed places in the selected register classification, fixed bins across selections.",
  "width":"container","height":610,"autosize":{"type":"fit","contains":"padding"},"padding":20,
  "projection":{"type":"albers","rotate":[-132,0,0],"center":[0,-27],"parallels":[-18,-36]},
  "params":[{"name":"heritageClass","value":"Indigenous","bind":{"input":"radio","options":["Historic","Indigenous","Natural"],"name":"Classification"}}],
  "layer":[
    {
      "data":{"url":"./data/australia-states.topojson","format":{"type":"topojson","feature":"states"}},
      "transform":[
        {"lookup":"properties.state_code","from":{"data":{"url":"./data/heritage-state-class.csv","format":{"type":"csv","parse":{"listed_places":"number","historic_places":"number","indigenous_places":"number","natural_places":"number","historic_share_pct":"number","indigenous_share_pct":"number","natural_share_pct":"number"}}},"key":"state_code","fields":["state_code","state_name","listed_places","historic_places","indigenous_places","natural_places","historic_share_pct","indigenous_share_pct","natural_share_pct"]}},
        {"calculate":"heritageClass == 'Historic' ? datum.historic_share_pct : heritageClass == 'Natural' ? datum.natural_share_pct : datum.indigenous_share_pct","as":"selected_share"},
        {"calculate":"heritageClass == 'Historic' ? datum.historic_places : heritageClass == 'Natural' ? datum.natural_places : datum.indigenous_places","as":"selected_count"},
        {"calculate":"format(datum.selected_share,'.1f') + '%'","as":"share_label"}
      ],
      "mark":{"type":"geoshape","stroke":"#8b9ba7","strokeWidth":0.8},
      "encoding":{
        "color":{"field":"selected_share","type":"quantitative","scale":{"type":"threshold","domain":[10,20,40,60],"range":["#eff3ff","#bdd7e7","#6baed6","#3182bd","#08519c"]},"legend":null},
        "tooltip":[{"field":"state_name","title":"State or territory"},{"field":"share_label","title":"Within-state share"},{"field":"selected_count","title":"Selected classification"},{"field":"listed_places","title":"All listed places in state"}]
      }
    },
    {
      "data":{"url":"./data/state-label-points.csv","format":{"type":"csv","parse":{"longitude":"number","latitude":"number"}}},
      "transform":[
        {"lookup":"state_code","from":{"data":{"url":"./data/heritage-state-class.csv","format":{"type":"csv","parse":{"listed_places":"number","historic_places":"number","indigenous_places":"number","natural_places":"number","historic_share_pct":"number","indigenous_share_pct":"number","natural_share_pct":"number"}}},"key":"state_code","fields":["listed_places","historic_places","indigenous_places","natural_places","historic_share_pct","indigenous_share_pct","natural_share_pct"]}},
        {"calculate":"heritageClass == 'Historic' ? datum.historic_share_pct : heritageClass == 'Natural' ? datum.natural_share_pct : datum.indigenous_share_pct","as":"selected_share"},
        {"calculate":"heritageClass == 'Historic' ? datum.historic_places : heritageClass == 'Natural' ? datum.natural_places : datum.indigenous_places","as":"selected_count"},
        {"calculate":"datum.state_code == 'ACT' ? 156 : datum.state_code == 'NSW' ? 150 : datum.state_code == 'VIC' ? 144 : datum.state_code == 'TAS' ? 151 : datum.longitude","as":"label_lon"},
        {"calculate":"datum.state_code == 'ACT' ? -37 : datum.state_code == 'NSW' ? -30 : datum.state_code == 'VIC' ? -39 : datum.state_code == 'TAS' ? -44 : datum.latitude","as":"label_lat"},
        {"calculate":"datum.state_code == 'ACT' ? ['Australian Capital','Territory'] : datum.state_code == 'NSW' ? ['New South Wales'] : datum.state_code == 'WA' ? ['Western Australia'] : datum.state_code == 'NT' ? ['Northern Territory'] : [datum.state_name]","as":"name_lines"},
        {"calculate":"format(datum.selected_share,'.1f') + '% (' + datum.selected_count + ' of ' + datum.listed_places + ')'","as":"value_label"}
      ],
      "layer":[
        {"mark":{"type":"rule","color":"#52616d","strokeWidth":1},"encoding":{"longitude":{"field":"longitude"},"latitude":{"field":"latitude"},"longitude2":{"field":"label_lon"},"latitude2":{"field":"label_lat"}}},
        {"mark":{"type":"text","fontSize":14,"fontWeight":600,"lineHeight":20,"color":"#20303d","stroke":"white","strokeWidth":3,"strokeJoin":"round","dy":-12},"encoding":{"longitude":{"field":"label_lon"},"latitude":{"field":"label_lat"},"text":{"field":"name_lines"}}},
        {"mark":{"type":"text","fontSize":14,"color":"#20303d","stroke":"white","strokeWidth":3,"strokeJoin":"round","dy":{"expr":"datum.state_code == 'ACT' ? 34 : 22"}},"encoding":{"longitude":{"field":"label_lon"},"latitude":{"field":"label_lat"},"text":{"field":"value_label"}}}
      ]
    },
    {
      "data":{"url":"./data/heritage-state-class.csv","format":{"type":"csv","parse":{"listed_places":"number","historic_places":"number","indigenous_places":"number","natural_places":"number","historic_share_pct":"number","indigenous_share_pct":"number","natural_share_pct":"number"}}},
      "transform":[
        {"calculate":"heritageClass == 'Historic' ? datum.historic_share_pct : heritageClass == 'Natural' ? datum.natural_share_pct : datum.indigenous_share_pct","as":"selected_share"},
        {"window":[{"op":"row_number","as":"rank"}],"sort":[{"field":"selected_share","order":"descending"}]},
        {"filter":"datum.rank == 1"},
        {"calculate":"['Highest ' + heritageClass + ' share', datum.state_name + ': ' + format(datum.selected_share,'.1f') + '%', 'Compare shares alongside state totals']","as":"annotation"}
      ],
      "mark":{"type":"text","align":"left","baseline":"top","fontSize":14,"lineHeight":22,"color":"#20303d","stroke":"white","strokeWidth":3},
      "encoding":{"x":{"value":8},"y":{"value":8},"text":{"field":"annotation"}}
    }
  ],
  "config":{"font":"Source Sans 3","view":{"stroke":null}}
}
