{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
  "description":"Reported overnight culture and heritage visitor stay-duration shares in New South Wales, calendar 2024.",
  "width":"container","height":374,"autosize":{"type":"fit","contains":"padding"},"padding":{"left":8,"right":30,"top":72,"bottom":8},
  "data":{"url":"https://raw.githubusercontent.com/vincent3113/fit3179-dv2-heritage-tourism/main/data/nsw-overnight-trip-length.json"},
  "transform":[
    {"calculate":"format(datum.visitor_share_pct_reported,'.0f') + '%'","as":"share_label"},
    {"calculate":"indexof(['1 night','2 nights','3 nights','4 to 7 nights','8 to 14 nights','15 or more nights'],datum.category)","as":"duration_order"},
    {"window":[{"op":"sum","field":"visitor_share_pct_reported","as":"cumulative_share"}],"sort":[{"field":"duration_order","order":"ascending"}],"frame":[null,0]},
    {"calculate":"datum.duration_order == 5 ? 'No upper limit is reported for this category' : 'About ' + format(100 - datum.cumulative_share,'.0f') + '% stayed more than ' + [1,2,3,7,14][datum.duration_order] + (datum.duration_order == 0 ? ' night' : ' nights')","as":"longer_stays"}
  ],
  "encoding":{
    "y":{"field":"category","type":"ordinal","sort":["1 night","2 nights","3 nights","4 to 7 nights","8 to 14 nights","15 or more nights"],"axis":{"title":null,"labelLimit":180,"minExtent":138}},
    "x":{"field":"visitor_share_pct_reported","type":"quantitative","scale":{"domain":[0,30],"zero":true},"axis":{"title":"Share of overnight culture and heritage visitors","values":[0,10,20,30],"labelExpr":"datum.label + '%'"}},
    "tooltip":[{"field":"category","title":"Stay in New South Wales"},{"field":"share_label","title":"Share of overnight visitors"},{"field":"longer_stays","title":"Longer stays"}]
  },
  "layer":[
    {"mark":{"type":"bar","size":24},"encoding":{"color":{"condition":{"test":"indexof(['1 night','2 nights','3 nights'],datum.category) >= 0","value":"#245b9e"},"value":"#818c94"}}},
    {"mark":{"type":"text","align":"left","dx":7,"fontSize":14,"color":"#20303d"},"encoding":{"text":{"field":"share_label"}}},
    {
      "name":"context_annotation",
      "transform":[{"filter":"indexof(['1 night','2 nights','3 nights'],datum.category) >= 0"},{"aggregate":[{"op":"sum","field":"visitor_share_pct_reported","as":"short_stay_share"}]},{"filter":"datum.short_stay_share > 50"},{"calculate":"['Short stays dominate','Longer trips remain a sizeable minority']","as":"annotation"}],
      "mark":{"type":"text","align":"left","baseline":"top","fontSize":14,"lineHeight":22,"color":"#20303d"},
      "encoding":{"x":{"value":0},"y":{"value":-52},"text":{"field":"annotation"},"tooltip":null}
    }
  ],
  "config":{"font":"Source Sans 3","view":{"stroke":null},"axis":{"labelFontSize":14,"titleFontSize":14,"titleFontWeight":"normal","labelColor":"#20303d","titleColor":"#20303d","gridColor":"#e7edf1","domain":false,"ticks":false}}
}
